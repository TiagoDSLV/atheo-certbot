# --- Claude Code ---
# Seul le fichier de réglages personnel est ignoré ; .claude/settings.json et
# .claude/agents/ sont partagés via git.
.claude/settings.local.json

# --- Données client (ne jamais committer) ---
parc-actuel/
# Exports CSV TBS posés à la racine (ex. 20261007084433.csv, plan_action_*.csv)
/*.csv
# Inventaire local (noms, mails), script bootstrap (réf. TBS), archive du projet avec parc-actuel/
inventory.yaml
/bootstrap*.sh
/*.zip

# --- Fichiers produits à l'exécution ---
# .eml du dry-run : contiennent les mots de passe des ZIP
outbox/
# ZIP livrés : contiennent les clés privées
deliveries/
state.db
state.db-*
data/keys/
*.pkey
*.key
*.pfx
*.p12
# Mails dry-run et journaux (destinataires, noms de clients)
*.eml
*.log

# --- Configuration locale et secrets ---
/config.yaml
/env
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
